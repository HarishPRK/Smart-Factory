# PLC Service Mode: "mock" | "aws" | "iotcore" | "mosquitto"
VITE_PLC_MODE=mock

# Mosquitto via local bridge (required when VITE_PLC_MODE=mosquitto)
# Run: npm run mqtt-bridge (connects to broker and exposes WS for browser)
VITE_MQTT_BRIDGE_URL=ws://localhost:9001

# IoT Core Direct (required when VITE_PLC_MODE=iotcore)
VITE_IOT_ENDPOINT=
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_REGION=us-east-1

# AWS API Gateway (required when VITE_PLC_MODE=aws)
VITE_AWS_API_GATEWAY_URL=
VITE_AWS_WS_URL=
