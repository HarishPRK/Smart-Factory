# ════════════════════════════════════════════════════════════════════════════
# Integration env vars — copy to .env and fill in real values
# ════════════════════════════════════════════════════════════════════════════

# Server port
PORT=3001

# ─── Dynamic Failover + Application Traffic Routing: AWS IoT Core ─────────
# The IoT Core endpoint for your account/region. Find it in the AWS Console
# under IoT Core → Settings → "Device data endpoint".
IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com
# AWS_IOT_ENDPOINT is accepted as a backwards-compatible alias.
# AWS_IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com

# Raw proto3 IPsec telemetry. The server subscribes to every comma-separated
# topic, tags each snapshot by its rdk/prpl prefix, and fans it out over SSE.
IOT_IPSEC_TOPICS=rdk/ipsec/metrics,prpl/ipsec/metrics

# Application-Aware Routing plugin telemetry (proto/aar.proto).
IOT_AAR_TOPICS=routing/flow,routing/tunnel,routing/route,routing/decision

# Live device inventory used for client-to-tunnel placement.
IOT_DEVICE_TOPICS=rdk/devices/inventory,prpl/devices/inventory

# AWS creds for SigV4 MQTT auth (used by aws-iot-device-sdk-v2). Either:
#   (a) long-term IAM access key (least preferred)
#   (b) STS temporary creds (preferred for prod)
#   (c) instance profile / IRSA (best on EC2/EKS — leave these blank)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional isolated live DeviceInfo stream for the embedded GW Operational Twin.
# The production EC2 service defaults to these values and subscribes read-only.
GATEWAY_TWIN_STREAM_HOST=127.0.0.1
GATEWAY_TWIN_STREAM_PORT=46121
GATEWAY_TWIN_DEVICE_INFO_TOPICS=prplos/deviceinfo/uptime,prplos/deviceinfo/softwareversion,prplos/deviceinfo/hardwareversion,prplos/deviceinfo/serialnumber,prplos/deviceinfo/memorystatus,prplos/deviceinfo/cpuutilization,prplos/deviceinfo/temperaturesensor,prplos/deviceinfo/processes

# ─── Dynamic Failover path control ─────────────────────────────────────────
# Commands publish to <prefix>/path/control and acks arrive on
# <prefix>/path/control/result. App routing publishes its binary proto3 command
# to <prefix>/approute/control using the same source prefix and connection.
IOT_PATH_PREFIXES=rdk,prpl

# ─── Governed Bedrock AI ───────────────────────────────────────────────────
LLM_PROVIDER=bedrock
AGENT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_APPROVED_MODELS=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Production: prefer an EC2/ECS IAM role or other temporary credentials.
# Bearer keys are for short-lived development only; never commit a real value.
AWS_BEARER_TOKEN_BEDROCK=
# Direct Anthropic is disabled unless both this flag and LLM_PROVIDER=anthropic
# are set in a non-production environment.
ALLOW_DIRECT_ANTHROPIC=false

# ─── Video Analytics: MJPEG upstreams ──────────────────────────────────────
# Base URLs of the two inference nodes. Stream paths get appended per route.
VIDEO_BASE_NVIDIA=http://192.168.10.100:5000
VIDEO_BASE_HAILO=http://192.168.10.160:5000

# Per-stream overrides (only set these if you need to point one stream
# somewhere different than its base). Format: VIDEO_UPSTREAM_<ID_IN_SNAKE>
# VIDEO_UPSTREAM_NV_WEAPON=http://10.0.0.5:5000/weapon_feed
# VIDEO_UPSTREAM_HA_FIRE=http://10.0.0.6:5000/firedetection_feed

# Optional full-URL overrides for stop APIs. By default, each configured stop
# path uses the same VIDEO_BASE_NVIDIA / VIDEO_BASE_HAILO host as its feed.
# VIDEO_STOP_UPSTREAM_NV_NANOOWL=http://10.0.0.5:5000/stop_nanoowl
# VIDEO_STOP_UPSTREAM_HA_FIRE=http://10.0.0.6:5000/stop_firedetection
