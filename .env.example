# PLC Service Mode: "mock" | "aws" | "iotcore" | "mosquitto"
VITE_PLC_MODE=mock

# Mosquitto via local bridge (required when VITE_PLC_MODE=mosquitto)
# Run: npm run mqtt-bridge (connects to broker and exposes WS for browser)
VITE_MQTT_BRIDGE_URL=ws://localhost:9001

# IoT Core Direct (required when VITE_PLC_MODE=iotcore)
VITE_IOT_ENDPOINT=
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_REGION=us-east-1

# AWS API Gateway (required when VITE_PLC_MODE=aws)
VITE_AWS_API_GATEWAY_URL=
VITE_AWS_WS_URL=

# Langgraph agent REST endpoint (separate from the Claude ai-proxy).
# Reached by POST /api/prompt (returns 202 + request_id) and
# GET /api/response/<id> until status !== "pending".
VITE_LANGGRAPH_API_BASE=http://192.168.10.71:8765

# ── AWS IoT KOS bridge (optional) ──────────────────────────
# `npm run mqtt-bridge` ALSO connects to AWS IoT Core via mTLS when all four
# of these are set, subscribes to AWS_IOT_TOPIC_FILTER, and forwards every
# message to the browser dashboard (KOSDispenseWidget consumes them).
# Browsers can't do mTLS with X.509 client certs — that's why the bridge
# does it on the device side and proxies via WebSocket.
AWS_IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CA_PATH=C:/Users/haris/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=C:/Users/haris/dispenser.cert.pem
AWS_IOT_KEY_PATH=C:/Users/haris/dispenser.private.key
AWS_IOT_TOPIC_FILTER=kos/#
