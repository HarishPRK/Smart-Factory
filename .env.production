# Overrides applied by `vite build` (production mode) on top of .env.
# Always use the WebSocket MQTT bridge in clean production builds. Local .env
# is intentionally gitignored and must not be required to enable live control.
VITE_PLC_MODE=mosquitto

# Empty = auto-detect the bridge URL at runtime: localhost/LAN dev hosts use
# ws://<host>:9001 directly; public hosts use the nginx /ws proxy on the same
# origin. Keeps one build working locally and on EC2 across hostname changes.
VITE_MQTT_BRIDGE_URL=

# Embedded meter receives only meter/data from the existing same-origin /ws bridge.
VITE_METER_TRANSPORT=websocket
VITE_METER_URL=
VITE_METER_TOPIC=meter/data

# Keep the production demo OEE values until a non-zero SiteWise roll-up is
# available. An explicit blank overrides the developer .env API URL.
VITE_SITEWISE_API_URL=

# Route browser requests through Nginx to the EC2 loopback reverse tunnel.
# Keeping this same-origin avoids exposing the plant-side LangGraph service.
VITE_LANGGRAPH_API_BASE=/langgraph
