# ════════════════════════════════════════════════════════════════════════════
# Integration env vars — copy to .env and fill in real values
# ════════════════════════════════════════════════════════════════════════════

# Server port
PORT=3001

# ─── DPS: AWS IoT Core (MQTT subscriber) ──────────────────────────────────
# The IoT Core endpoint for your account/region. Find it in the AWS Console
# under IoT Core → Settings → "Device data endpoint".
AWS_IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com
AWS_IOT_TOPIC=rdk/ipsec/metrics

# AWS creds for SigV4 MQTT auth (used by aws-iot-device-sdk-v2). Either:
#   (a) long-term IAM access key (least preferred)
#   (b) STS temporary creds (preferred for prod)
#   (c) instance profile / IRSA (best on EC2/EKS — leave these blank)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── DPS: gateway path-control API ─────────────────────────────────────────
# The DPS page's Force Fiber / Force 5G / Auto buttons POST to /api/gateway/path
# which forwards here. Must be reachable from the server (NOT the browser).
GATEWAY_PATH_HOST=http://192.168.1.201:8090

# ─── DPS: Bedrock AI insight (OPTIONAL) ────────────────────────────────────
# Required only if you ported the AI Insight card. Prefer the long-term ABSK
# key over the short-lived bedrock-api-key-… variant (which expires in 1 hr).
AWS_BEARER_TOKEN_BEDROCK=

# ─── Video Analytics: MJPEG upstreams ──────────────────────────────────────
# Base URLs of the two inference nodes. Stream paths get appended per route.
VIDEO_BASE_NVIDIA=http://192.168.10.100:5000
VIDEO_BASE_HAILO=http://192.168.10.160:5000

# Per-stream overrides (only set these if you need to point one stream
# somewhere different than its base). Format: VIDEO_UPSTREAM_<ID_IN_SNAKE>
# VIDEO_UPSTREAM_NV_WEAPON=http://10.0.0.5:5000/weapon_feed
# VIDEO_UPSTREAM_HA_FIRE=http://10.0.0.6:5000/firedetection_feed
