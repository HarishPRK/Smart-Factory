# AI Proxy — set your key here locally (never commit this)
ANTHROPIC_API_KEY=

VITE_PLC_MODE=mosquitto
# Leave empty to auto-detect host from browser URL (works over network)
# VITE_MQTT_BRIDGE_URL=ws://localhost:9001

# AWS (kept for reference, unused when mode=mosquitto)
VITE_AWS_REGION=us-east-1
VITE_AWS_API_GATEWAY_URL=https://9bg6hqdf00.execute-api.us-east-1.amazonaws.com/prod
VITE_AWS_WS_URL=wss://ycm3x6itrf.execute-api.us-east-1.amazonaws.com/prod

# SiteWise Query API
VITE_SITEWISE_API_URL=https://3szpa8f6ff.execute-api.us-east-1.amazonaws.com/sitewise

# ── AWS IoT KOS bridge ────────────────────────────────────
# `npm run mqtt-bridge` connects to AWS IoT via mTLS, subscribes to kos/#,
# and forwards every message to the dashboard alongside the local plc/#.
# Fill in AWS_IOT_ENDPOINT — find it in the AWS IoT console:
#   AWS IoT → Settings → "Device data endpoint"
#   Looks like: a1b2c3d4-ats.iot.us-east-1.amazonaws.com
AWS_IOT_ENDPOINT=alht1i2bx8tzt-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CA_PATH=C:/Users/haris/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=C:/Users/haris/dispenser.cert.pem
AWS_IOT_KEY_PATH=C:/Users/haris/dispenser.private.key
# Narrowed from `kos/#` to `kos/dispenser/4287/+` — the policy attached to
# the dispenser cert grants Subscribe on this filter (and on the explicit
# pour / recommendations sub-topics) but not on the broad `kos/#` wildcard.
# `+` matches one level, so the bridge gets pour, recommendations, etc.
AWS_IOT_TOPIC_FILTER=kos/dispenser/4287/+

# ── Bedrock AI Insight (DPS modal) ───────────────────────
# Long-term ABSK Bedrock API key consumed by server/bedrockBearer.ts +
# server/llm.ts to power the /api/ipsec/insight SSE endpoint that drives
# the AI insight card inside the Dynamic Path Selection modal.
# AWS_REGION here is the **server-side** region; the VITE_AWS_REGION above
# is client-only. They should match the region in which Bedrock model
# access was granted for account 841019700679 (decoded from the ABSK key).
AWS_REGION=us-east-1

# ── DPS IPsec ingest (server subscribes to AWS IoT Core) ──
# The edge gateway publishes its IPsec telemetry protobuf on this topic.
# Confirmed via MQTT explorer: the device publishes on rdk/ipsec/metrics.
IOT_IPSEC_TOPIC=rdk/ipsec/metrics
IOT_IPSEC_TOPICS=rdk/ipsec/metrics,prpl/ipsec/metrics
IOT_AAR_TOPICS=routing/flow,routing/tunnel,routing/route,routing/decision
IOT_DEVICE_TOPICS=rdk/devices/inventory,prpl/devices/inventory
# DPS path-control: the Force Fiber / Force 5G / Auto buttons publish here; the
# gateway's mqtt bridge relays to the local broker the com.rdk.pathcontrol
# Greengrass component listens on. Must match the component's topicPrefix (rdk).
IOT_PATH_CONTROL_TOPIC=rdk/path/control
IOT_PATH_PREFIXES=rdk,prpl
# The server authenticates to AWS IoT with SigV4 (NOT the X.509 certs the KOS
# bridge uses). It needs AWS access keys in env. Uncomment + fill these in:
AWS_ACCESS_KEY_ID=AKIA4HUFOGXDS7UC4REZ
AWS_SECRET_ACCESS_KEY=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
VITE_MQTT_BRIDGE_URL=ws://192.168.10.135:9001
